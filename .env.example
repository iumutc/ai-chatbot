MODEL_ID=Qwen/Qwen2.5-3B-Instruct
DEVICE=cuda
MAX_NEW_TOKENS=256
CHAT_HISTORY_LIMIT=8
CHAT_DB_PATH=app/data/chat.db

RAG_ENABLED=true
RAG_TOP_K=4
RAG_MIN_SCORE=0.15
RAG_INDEX_PATH=app/data/rag_index.json
RAG_KB_PATH=app/data/knowledge_base.json
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# mock = answer product questions from the knowledge base, entegra = live API
CHANNEL_DATA_PROVIDER=mock

ENTEGRA_ENABLED=false
ENTEGRA_BASE_URL=
ENTEGRA_PRODUCTS_ENDPOINT=/product/page={page}/
ENTEGRA_STOCK_ENDPOINT=
ENTEGRA_TIMEOUT_SEC=15
ENTEGRA_MAX_PAGES=50

# jwt: uses ENTEGRA_TOKEN, or obtains one with USERNAME/PASSWORD
# any other value: sends API key/secret headers
ENTEGRA_AUTH_TYPE=jwt
ENTEGRA_AUTH_ENDPOINT=/api/user/token/obtain/
ENTEGRA_USERNAME=
ENTEGRA_PASSWORD=
ENTEGRA_TOKEN=
ENTEGRA_API_KEY=
ENTEGRA_API_SECRET=
ENTEGRA_API_KEY_HEADER=X-API-KEY
ENTEGRA_API_SECRET_HEADER=X-API-SECRET
ENTEGRA_STOCK_CACHE_PATH=app/data/stock_cache.json
